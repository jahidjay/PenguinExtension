<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable"
              xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>

  <Commands package="guidPenguinExtensionPackage">

    <!-- Sub-menu under the Tools menu -->
    <Menus>
      <Menu guid="guidPenguinExtensionCmdSet" id="PenguinSubMenu"
            priority="0x0700" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_TOOLS_OTHER2"/>
        <Strings>
          <ButtonText>Penguin Extension 🐧</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <!-- Command groups inside our sub-menu -->
    <Groups>
      <!-- Navigation group -->
      <Group guid="guidPenguinExtensionCmdSet" id="PenguinNavGroup" priority="0x0100">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinSubMenu"/>
      </Group>
      <!-- Refactoring group -->
      <Group guid="guidPenguinExtensionCmdSet" id="PenguinRefactorGroup" priority="0x0200">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinSubMenu"/>
      </Group>
      <!-- Windows group -->
      <Group guid="guidPenguinExtensionCmdSet" id="PenguinWindowsGroup" priority="0x0300">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinSubMenu"/>
      </Group>
    </Groups>

    <!-- Commands -->
    <Buttons>
      <!-- Go To Unreal Definition -->
      <Button guid="guidPenguinExtensionCmdSet" id="GoToUnrealDefinitionId"
              priority="0x0100" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinNavGroup"/>
        <Icon guid="guidPenguinImages" id="bmpPenguin"/>
        <Strings>
          <ButtonText>Go To Unreal Definition</ButtonText>
          <ToolTipText>Navigate to the Unreal Engine definition of the symbol under the cursor (Alt+U, D)</ToolTipText>
        </Strings>
      </Button>

      <!-- Open Unreal Explorer -->
      <Button guid="guidPenguinExtensionCmdSet" id="OpenUnrealExplorerId"
              priority="0x0200" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinWindowsGroup"/>
        <Icon guid="guidPenguinImages" id="bmpPenguin"/>
        <Strings>
          <ButtonText>Penguin Explorer</ButtonText>
          <ToolTipText>Open the Unreal Symbol Explorer tool window (Alt+U, E)</ToolTipText>
        </Strings>
      </Button>

      <!-- Generate Implementation -->
      <Button guid="guidPenguinExtensionCmdSet" id="GenerateImplementationId"
              priority="0x0100" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinRefactorGroup"/>
        <Strings>
          <ButtonText>Generate Implementation (.cpp)</ButtonText>
          <ToolTipText>Generate a .cpp skeleton from the function declaration on the current line (Alt+U, I)</ToolTipText>
        </Strings>
      </Button>

      <!-- Generate Getter/Setter -->
      <Button guid="guidPenguinExtensionCmdSet" id="GenerateGetterSetterId"
              priority="0x0200" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinRefactorGroup"/>
        <Strings>
          <ButtonText>Generate Getter/Setter</ButtonText>
          <ToolTipText>Generate Get/Set methods from the UPROPERTY on the current line (Alt+U, G)</ToolTipText>
        </Strings>
      </Button>

      <!-- Open Symbol Inspector -->
      <Button guid="guidPenguinExtensionCmdSet" id="OpenSymbolInspectorId"
              priority="0x0300" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinWindowsGroup"/>
        <Icon guid="guidPenguinImages" id="bmpPenguin"/>
        <Strings>
          <ButtonText>Symbol Inspector</ButtonText>
          <ToolTipText>Open the Symbol Inspector window showing live documentation (Alt+U, S)</ToolTipText>
        </Strings>
      </Button>

      <!-- Open Shortcuts Reference -->
      <Button guid="guidPenguinExtensionCmdSet" id="OpenShortcutsReferenceId"
              priority="0x0400" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinWindowsGroup"/>
        <Icon guid="guidPenguinImages" id="bmpPenguin"/>
        <Strings>
          <ButtonText>Keyboard Shortcuts</ButtonText>
          <ToolTipText>Show all PenguinExtension keyboard shortcuts (Alt+U, K)</ToolTipText>
        </Strings>
      </Button>
      <Button guid="guidPenguinExtensionCmdSet" id="CoreStatusId" priority="0x0700" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinWindowsGroup"/>
        <Strings><ButtonText>Backend Status</ButtonText></Strings>
      </Button>
      <Button guid="guidPenguinExtensionCmdSet" id="CoreReindexId" priority="0x0701" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinWindowsGroup"/>
        <Strings><ButtonText>Reindex Core Workspace</ButtonText></Strings>
      </Button>
      <Button guid="guidPenguinExtensionCmdSet" id="RestartBackendId" priority="0x0702" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinWindowsGroup"/>
        <Strings><ButtonText>Restart Backend</ButtonText></Strings>
      </Button>
      <Button guid="guidPenguinExtensionCmdSet" id="AIExplainId" priority="0x0710" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinWindowsGroup"/>
        <Strings><ButtonText>AI Explain Selection (Preview Only)</ButtonText></Strings>
      </Button>
      <Button guid="guidPenguinExtensionCmdSet" id="AIGenerateId" priority="0x0711" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinWindowsGroup"/>
        <Strings><ButtonText>AI Proposed Implementation (Preview Only)</ButtonText></Strings>
      </Button>
      <Button guid="guidPenguinExtensionCmdSet" id="CancelCoreJobId" priority="0x0712" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinWindowsGroup"/>
        <Strings><ButtonText>Cancel Core Action</ButtonText></Strings>
      </Button>
      <!-- Visual Assist–style navigation -->
      <Button guid="guidPenguinExtensionCmdSet" id="FindSymbolId" priority="0x0110" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinNavGroup"/>
        <Icon guid="guidPenguinImages" id="bmpPenguin"/>
        <Strings><ButtonText>Find Symbol...</ButtonText><ToolTipText>Search indexed Unreal symbols (Alt+U, Y)</ToolTipText></Strings>
      </Button>
      <Button guid="guidPenguinExtensionCmdSet" id="OpenFileInSolutionId" priority="0x0111" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinNavGroup"/>
        <Strings><ButtonText>Open File in Project...</ButtonText><ToolTipText>Fuzzy-open any project source/config file (Alt+U, O)</ToolTipText></Strings>
      </Button>
      <Button guid="guidPenguinExtensionCmdSet" id="ToggleHeaderSourceId" priority="0x0112" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinNavGroup"/>
        <Strings><ButtonText>Toggle Header/Source</ButtonText><ToolTipText>Switch between .h and .cpp, including Public/Private layouts (Alt+U, H)</ToolTipText></Strings>
      </Button>
      <Button guid="guidPenguinExtensionCmdSet" id="GoToImplementationId" priority="0x0113" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinNavGroup"/>
        <Strings><ButtonText>Go To Implementation</ButtonText><ToolTipText>Jump to the Owner::Function body in the .cpp (Alt+U, J)</ToolTipText></Strings>
      </Button>
      <Button guid="guidPenguinExtensionCmdSet" id="GoToRelatedId" priority="0x0114" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinNavGroup"/>
        <Strings><ButtonText>Go To Related...</ButtonText><ToolTipText>Bases, derived classes, owner, implementation and corresponding file (Alt+U, R)</ToolTipText></Strings>
      </Button>
      <Button guid="guidPenguinExtensionCmdSet" id="ListMethodsId" priority="0x0115" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinNavGroup"/>
        <Strings><ButtonText>List Methods in File...</ButtonText><ToolTipText>Pick a function in the current file (Alt+U, M)</ToolTipText></Strings>
      </Button>
      <Button guid="guidPenguinExtensionCmdSet" id="FindReferencesId" priority="0x0116" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinNavGroup"/>
        <Icon guid="guidPenguinImages" id="bmpPenguin"/>
        <Strings><ButtonText>Find References</ButtonText><ToolTipText>Find references to the symbol under the cursor (Alt+U, F)</ToolTipText></Strings>
      </Button>
      <Button guid="guidPenguinExtensionCmdSet" id="OpenDefinitionPreviewId" priority="0x0117" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinWindowsGroup"/>
        <Icon guid="guidPenguinImages" id="bmpPenguin"/>
        <Strings><ButtonText>Definition Preview</ButtonText><ToolTipText>Live preview of the declaration/implementation under the cursor (Alt+U, W)</ToolTipText></Strings>
      </Button>

      <!-- Visual Assist–style refactorings -->
      <Button guid="guidPenguinExtensionCmdSet" id="RenameSymbolId" priority="0x0210" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinRefactorGroup"/>
        <Strings><ButtonText>Rename...</ButtonText><ToolTipText>Rename with preview and optional Unreal CoreRedirect (Alt+U, N)</ToolTipText></Strings>
      </Button>
      <Button guid="guidPenguinExtensionCmdSet" id="AddIncludeId" priority="0x0211" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinRefactorGroup"/>
        <Strings><ButtonText>Add Include</ButtonText><ToolTipText>Add #include for the symbol under the cursor (Alt+U, A)</ToolTipText></Strings>
      </Button>
      <Button guid="guidPenguinExtensionCmdSet" id="CreateDeclarationId" priority="0x0212" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinRefactorGroup"/>
        <Strings><ButtonText>Create Declaration</ButtonText><ToolTipText>Declare the .cpp definition on this line in its class header (Alt+U, C)</ToolTipText></Strings>
      </Button>
      <Button guid="guidPenguinExtensionCmdSet" id="MoveImplementationId" priority="0x0213" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinRefactorGroup"/>
        <Strings><ButtonText>Move Implementation to Source</ButtonText><ToolTipText>Move an inline header body into the .cpp (Alt+U, V)</ToolTipText></Strings>
      </Button>
      <Button guid="guidPenguinExtensionCmdSet" id="EncapsulateFieldId" priority="0x0214" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinRefactorGroup"/>
        <Strings><ButtonText>Encapsulate Field</ButtonText><ToolTipText>Make the field private and add Get/Set accessors (Alt+U, P)</ToolTipText></Strings>
      </Button>
      <Button guid="guidPenguinExtensionCmdSet" id="DocumentMethodId" priority="0x0215" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinRefactorGroup"/>
        <Strings><ButtonText>Document Method</ButtonText><ToolTipText>Insert a /** @param @return */ comment (Alt+U, Q)</ToolTipText></Strings>
      </Button>
      <!-- Code generation -->
      <Button guid="guidPenguinExtensionCmdSet" id="InsertSnippetId" priority="0x0216" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinRefactorGroup"/>
        <Strings><ButtonText>Insert Snippet / Surround With...</ButtonText><ToolTipText>C++ and SDL2 snippets; with a selection, wraps it (Alt+U, T)</ToolTipText></Strings>
      </Button>
      <Button guid="guidPenguinExtensionCmdSet" id="ImplementVirtualMethodsId" priority="0x0217" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinRefactorGroup"/>
        <Strings><ButtonText>Implement Virtual Methods...</ButtonText><ToolTipText>Declare overrides of base-class virtuals (Alt+U, B)</ToolTipText></Strings>
      </Button>
      <Button guid="guidPenguinExtensionCmdSet" id="AddMissingCasesId" priority="0x0218" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinRefactorGroup"/>
        <Strings><ButtonText>Add Missing Case Statements</ButtonText><ToolTipText>Add a case for every unhandled enum value (Alt+U, L)</ToolTipText></Strings>
      </Button>
      <Button guid="guidPenguinExtensionCmdSet" id="IntroduceVariableId" priority="0x0219" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinRefactorGroup"/>
        <Strings><ButtonText>Introduce Variable...</ButtonText><ToolTipText>Replace the selected expression with a named local (Alt+U, X)</ToolTipText></Strings>
      </Button>
      <Button guid="guidPenguinExtensionCmdSet" id="AddForwardDeclarationId" priority="0x021A" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinRefactorGroup"/>
        <Strings><ButtonText>Add Forward Declaration</ButtonText><ToolTipText>Add 'class X;' for the type under the cursor (Alt+U, Z)</ToolTipText></Strings>
      </Button>
      <Button guid="guidPenguinExtensionCmdSet" id="SelfTestId" priority="0x0090" type="Button">
        <Parent guid="guidPenguinExtensionCmdSet" id="PenguinWindowsGroup"/>
        <Icon guid="guidPenguinImages" id="bmpPenguin"/>
        <Strings><ButtonText>Penguin Self-Test</ButtonText><ToolTipText>Check every Penguin feature and write a report to Output → PenguinExtension (Alt+U, U)</ToolTipText></Strings>
      </Button>
    </Buttons>

    <Bitmaps>
      <!-- Original penguin artwork (Resources\PenguinCommands.png, 16x16) -->
      <Bitmap guid="guidPenguinImages" href="Resources\PenguinCommands.png" usedList="bmpPenguin"/>
    </Bitmaps>

  </Commands>

  <!-- Key bindings -->
  <KeyBindings>
    <!-- Ctrl+Shift+U, D → Go To Unreal Definition -->
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="GoToUnrealDefinitionId"
                editor="guidVSStd97"
                key1="U" mod1="Control Shift"
                key2="D"/>

    <!-- Ctrl+Shift+U, E → Open Unreal Explorer -->
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="OpenUnrealExplorerId"
                editor="guidVSStd97"
                key1="U" mod1="Control Shift"
                key2="E"/>

    <!-- Ctrl+Shift+U, I → Generate Implementation -->
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="GenerateImplementationId"
                editor="guidVSStd97"
                key1="U" mod1="Control Shift"
                key2="I"/>

    <!-- Ctrl+Shift+U, G → Generate Getter/Setter -->
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="GenerateGetterSetterId"
                editor="guidVSStd97"
                key1="U" mod1="Control Shift"
                key2="G"/>

    <!-- Ctrl+Shift+U, S → Symbol Inspector -->
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="OpenSymbolInspectorId"
                editor="guidVSStd97"
                key1="U" mod1="Control Shift"
                key2="S"/>

    <!-- Ctrl+Shift+U, K → Keyboard Shortcuts -->
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="OpenShortcutsReferenceId"
                editor="guidVSStd97"
                key1="U" mod1="Control Shift"
                key2="K"/>
    <!-- Visual Assist–style commands: Ctrl+Shift+U, then … -->
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="FindSymbolId" editor="guidVSStd97" key1="U" mod1="Control Shift" key2="Y"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="OpenFileInSolutionId" editor="guidVSStd97" key1="U" mod1="Control Shift" key2="O"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="ToggleHeaderSourceId" editor="guidVSStd97" key1="U" mod1="Control Shift" key2="H"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="GoToImplementationId" editor="guidVSStd97" key1="U" mod1="Control Shift" key2="J"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="GoToRelatedId" editor="guidVSStd97" key1="U" mod1="Control Shift" key2="R"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="ListMethodsId" editor="guidVSStd97" key1="U" mod1="Control Shift" key2="M"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="FindReferencesId" editor="guidVSStd97" key1="U" mod1="Control Shift" key2="F"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="OpenDefinitionPreviewId" editor="guidVSStd97" key1="U" mod1="Control Shift" key2="W"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="RenameSymbolId" editor="guidVSStd97" key1="U" mod1="Control Shift" key2="N"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="AddIncludeId" editor="guidVSStd97" key1="U" mod1="Control Shift" key2="A"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="CreateDeclarationId" editor="guidVSStd97" key1="U" mod1="Control Shift" key2="C"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="MoveImplementationId" editor="guidVSStd97" key1="U" mod1="Control Shift" key2="V"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="EncapsulateFieldId" editor="guidVSStd97" key1="U" mod1="Control Shift" key2="P"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="DocumentMethodId" editor="guidVSStd97" key1="U" mod1="Control Shift" key2="Q"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="InsertSnippetId" editor="guidVSStd97" key1="U" mod1="Control Shift" key2="T"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="ImplementVirtualMethodsId" editor="guidVSStd97" key1="U" mod1="Control Shift" key2="B"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="AddMissingCasesId" editor="guidVSStd97" key1="U" mod1="Control Shift" key2="L"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="IntroduceVariableId" editor="guidVSStd97" key1="U" mod1="Control Shift" key2="X"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="AddForwardDeclarationId" editor="guidVSStd97" key1="U" mod1="Control Shift" key2="Z"/>
    <!-- Alt+U chords: same letters as Ctrl+Shift+U. Ctrl+Shift+U is Edit.MakeUppercase inside the text editor, so these are the reliable ones. -->
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="GoToUnrealDefinitionId" editor="guidVSStd97" key1="U" mod1="Alt" key2="D"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="OpenUnrealExplorerId" editor="guidVSStd97" key1="U" mod1="Alt" key2="E"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="GenerateImplementationId" editor="guidVSStd97" key1="U" mod1="Alt" key2="I"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="GenerateGetterSetterId" editor="guidVSStd97" key1="U" mod1="Alt" key2="G"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="OpenSymbolInspectorId" editor="guidVSStd97" key1="U" mod1="Alt" key2="S"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="OpenShortcutsReferenceId" editor="guidVSStd97" key1="U" mod1="Alt" key2="K"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="FindSymbolId" editor="guidVSStd97" key1="U" mod1="Alt" key2="Y"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="OpenFileInSolutionId" editor="guidVSStd97" key1="U" mod1="Alt" key2="O"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="ToggleHeaderSourceId" editor="guidVSStd97" key1="U" mod1="Alt" key2="H"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="GoToImplementationId" editor="guidVSStd97" key1="U" mod1="Alt" key2="J"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="GoToRelatedId" editor="guidVSStd97" key1="U" mod1="Alt" key2="R"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="ListMethodsId" editor="guidVSStd97" key1="U" mod1="Alt" key2="M"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="FindReferencesId" editor="guidVSStd97" key1="U" mod1="Alt" key2="F"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="OpenDefinitionPreviewId" editor="guidVSStd97" key1="U" mod1="Alt" key2="W"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="RenameSymbolId" editor="guidVSStd97" key1="U" mod1="Alt" key2="N"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="AddIncludeId" editor="guidVSStd97" key1="U" mod1="Alt" key2="A"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="CreateDeclarationId" editor="guidVSStd97" key1="U" mod1="Alt" key2="C"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="MoveImplementationId" editor="guidVSStd97" key1="U" mod1="Alt" key2="V"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="EncapsulateFieldId" editor="guidVSStd97" key1="U" mod1="Alt" key2="P"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="DocumentMethodId" editor="guidVSStd97" key1="U" mod1="Alt" key2="Q"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="InsertSnippetId" editor="guidVSStd97" key1="U" mod1="Alt" key2="T"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="ImplementVirtualMethodsId" editor="guidVSStd97" key1="U" mod1="Alt" key2="B"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="AddMissingCasesId" editor="guidVSStd97" key1="U" mod1="Alt" key2="L"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="IntroduceVariableId" editor="guidVSStd97" key1="U" mod1="Alt" key2="X"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="AddForwardDeclarationId" editor="guidVSStd97" key1="U" mod1="Alt" key2="Z"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="SelfTestId" editor="guidVSStd97" key1="U" mod1="Alt" key2="U"/>
    <!-- Visual Assist default keys, scoped to the text editor (where VA binds them). -->
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="ToggleHeaderSourceId" editor="guidTextEditorScope" key1="O" mod1="Alt"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="GoToImplementationId" editor="guidTextEditorScope" key1="G" mod1="Alt"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="ListMethodsId" editor="guidTextEditorScope" key1="M" mod1="Alt"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="FindSymbolId" editor="guidTextEditorScope" key1="S" mod1="Alt Shift"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="OpenFileInSolutionId" editor="guidTextEditorScope" key1="O" mod1="Alt Shift"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="GoToRelatedId" editor="guidTextEditorScope" key1="G" mod1="Alt Shift"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="FindReferencesId" editor="guidTextEditorScope" key1="F" mod1="Alt Shift"/>
    <KeyBinding guid="guidPenguinExtensionCmdSet" id="RenameSymbolId" editor="guidTextEditorScope" key1="R" mod1="Alt Shift"/>
  </KeyBindings>

  <!-- GUID and ID symbol definitions — must match PenguinExtensionCommandIds.cs -->
  <Symbols>
    <!-- Text Editor key-binding scope (GUID_TextEditorFactory) -->
    <GuidSymbol name="guidTextEditorScope" value="{8B382828-6202-11D1-8870-0000F87579D2}"/>
    <GuidSymbol name="guidPenguinImages" value="{3E8B5C1A-9D4F-4A7E-B2C6-8F1D0E5A3B79}">
      <IDSymbol name="bmpPenguin" value="1"/>
    </GuidSymbol>
    <GuidSymbol name="guidPenguinExtensionPackage"
                value="{7D9B3C2E-8A4F-4B1D-9E5C-6F0A2D3B8C7E}"/>

    <GuidSymbol name="guidPenguinExtensionCmdSet"
                value="{E5A3C1D9-4B2F-4E8A-B6D0-7C9F1A5E3D2B}">
      <IDSymbol name="PenguinSubMenu"              value="0x1000"/>
      <IDSymbol name="PenguinNavGroup"              value="0x1050"/>
      <IDSymbol name="PenguinRefactorGroup"         value="0x1060"/>
      <IDSymbol name="PenguinWindowsGroup"          value="0x1070"/>
      <IDSymbol name="GoToUnrealDefinitionId"       value="0x0100"/>
      <IDSymbol name="OpenUnrealExplorerId"         value="0x0200"/>
      <IDSymbol name="GenerateImplementationId"     value="0x0300"/>
      <IDSymbol name="GenerateGetterSetterId"       value="0x0400"/>
      <IDSymbol name="OpenSymbolInspectorId"        value="0x0500"/>
      <IDSymbol name="OpenShortcutsReferenceId"     value="0x0600"/>
      <IDSymbol name="CoreStatusId" value="0x0700"/>
      <IDSymbol name="CoreReindexId" value="0x0701"/>
      <IDSymbol name="RestartBackendId" value="0x0702"/>
      <IDSymbol name="AIExplainId" value="0x0710"/>
      <IDSymbol name="AIGenerateId" value="0x0711"/>
      <IDSymbol name="CancelCoreJobId" value="0x0712"/>
      <IDSymbol name="FindSymbolId" value="0x0800"/>
      <IDSymbol name="OpenFileInSolutionId" value="0x0801"/>
      <IDSymbol name="ToggleHeaderSourceId" value="0x0802"/>
      <IDSymbol name="GoToRelatedId" value="0x0803"/>
      <IDSymbol name="ListMethodsId" value="0x0804"/>
      <IDSymbol name="GoToImplementationId" value="0x0805"/>
      <IDSymbol name="FindReferencesId" value="0x0806"/>
      <IDSymbol name="OpenDefinitionPreviewId" value="0x0807"/>
      <IDSymbol name="RenameSymbolId" value="0x0900"/>
      <IDSymbol name="AddIncludeId" value="0x0901"/>
      <IDSymbol name="CreateDeclarationId" value="0x0902"/>
      <IDSymbol name="MoveImplementationId" value="0x0903"/>
      <IDSymbol name="EncapsulateFieldId" value="0x0904"/>
      <IDSymbol name="DocumentMethodId" value="0x0905"/>
      <IDSymbol name="InsertSnippetId" value="0x0906"/>
      <IDSymbol name="ImplementVirtualMethodsId" value="0x0907"/>
      <IDSymbol name="AddMissingCasesId" value="0x0908"/>
      <IDSymbol name="IntroduceVariableId" value="0x0909"/>
      <IDSymbol name="AddForwardDeclarationId" value="0x090A"/>
      <IDSymbol name="SelfTestId" value="0x0A00"/>
    </GuidSymbol>
  </Symbols>

</CommandTable>
