<UserControl x:Class="PenguinExtention.UI.SymbolInspectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
             Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
        <StackPanel x:Name="ContentPanel" Margin="4">

            <!-- Header: Symbol name + kind -->
            <TextBlock x:Name="SymbolHeader" FontSize="16" FontWeight="Bold"
                       Text="No symbol selected" Margin="0,0,0,8"
                       TextWrapping="Wrap"/>

            <!-- Signature -->
            <Border x:Name="SignatureSection" Visibility="Collapsed"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                    CornerRadius="4" Padding="8" Margin="0,0,0,6">
                <TextBlock x:Name="SignatureText" FontFamily="Consolas" FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Inheritance chain -->
            <StackPanel x:Name="InheritanceSection" Visibility="Collapsed" Margin="0,0,0,6">
                <TextBlock Text="🔗 Inheritance" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock x:Name="InheritanceText" TextWrapping="Wrap" Margin="12,0,0,0"/>
            </StackPanel>

            <!-- Meta specifiers -->
            <StackPanel x:Name="SpecifiersSection" Visibility="Collapsed" Margin="0,0,0,6">
                <TextBlock Text="⚙ Specifiers" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock x:Name="SpecifiersText" TextWrapping="Wrap" Margin="12,0,0,0"/>
            </StackPanel>

            <!-- Owner class -->
            <StackPanel x:Name="OwnerSection" Visibility="Collapsed" Margin="0,0,0,6">
                <TextBlock Text="📦 Member of" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock x:Name="OwnerText" Margin="12,0,0,0"/>
            </StackPanel>

            <!-- Documentation comment -->
            <StackPanel x:Name="DocSection" Visibility="Collapsed" Margin="0,0,0,6">
                <TextBlock Text="📝 Documentation" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock x:Name="DocText" TextWrapping="Wrap" Margin="12,0,0,0"/>
            </StackPanel>

            <!-- Source file location -->
            <StackPanel x:Name="LocationSection" Visibility="Collapsed" Margin="0,0,0,6">
                <TextBlock Text="📁 Location" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock x:Name="LocationText" Foreground="DodgerBlue" Margin="12,0,0,0"
                           Cursor="Hand" MouseLeftButtonUp="LocationText_Click"/>
            </StackPanel>

            <!-- Source badge -->
            <Border x:Name="SourceBadge" Visibility="Collapsed"
                    CornerRadius="3" Padding="4,2" HorizontalAlignment="Left" Margin="0,4,0,0">
                <TextBlock x:Name="SourceText" FontSize="10"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
