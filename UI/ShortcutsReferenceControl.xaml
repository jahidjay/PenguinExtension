<UserControl x:Class="PenguinExtention.UI.ShortcutsReferenceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
             Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
        <StackPanel Margin="8">

            <TextBlock Text="🐧 PenguinExtension Shortcuts" FontSize="16" FontWeight="Bold"
                       Margin="0,0,0,12"/>

            <!-- Navigation -->
            <TextBlock Text="Navigation" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="DodgerBlue"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" FontFamily="Consolas" Text="Alt+U, D" Margin="0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Go To Unreal Definition — Navigate to the source of the symbol under cursor" Margin="4,2" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="1" Grid.Column="0" FontFamily="Consolas" Text="Alt+U, E" Margin="0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Open Unreal Explorer — Browse all indexed Unreal symbols" Margin="4,2" TextWrapping="Wrap"/>
            </Grid>

            <!-- Refactoring -->
            <TextBlock Text="Refactoring" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="DodgerBlue"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" FontFamily="Consolas" Text="Alt+U, I" Margin="0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Generate Implementation — Create .cpp skeleton from .h function declaration" Margin="4,2" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="1" Grid.Column="0" FontFamily="Consolas" Text="Alt+U, G" Margin="0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Generate Getter/Setter — Create Get/Set methods from UPROPERTY" Margin="4,2" TextWrapping="Wrap"/>
            </Grid>

            <!-- Tool Windows -->
            <TextBlock Text="Tool Windows" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="DodgerBlue"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" FontFamily="Consolas" Text="Alt+U, S" Margin="0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Symbol Inspector — Live documentation for the symbol under cursor" Margin="4,2" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="1" Grid.Column="0" FontFamily="Consolas" Text="Alt+U, K" Margin="0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Keyboard Shortcuts — This window" Margin="4,2" TextWrapping="Wrap"/>
            </Grid>

            <!-- Visual Assist–style commands (Visual Assist default key in brackets) -->
            <TextBlock Text="Visual Assist–style Navigation" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="DodgerBlue"/>
            <StackPanel Margin="8,0,0,12">
                <TextBlock FontFamily="Consolas" Margin="0,2" TextWrapping="Wrap" Text="Alt+U, Y   Find Symbol            [VA: Shift+Alt+S]"/>
                <TextBlock FontFamily="Consolas" Margin="0,2" TextWrapping="Wrap" Text="Alt+U, O   Open File in Project   [VA: Shift+Alt+O]"/>
                <TextBlock FontFamily="Consolas" Margin="0,2" TextWrapping="Wrap" Text="Alt+U, H   Toggle Header/Source   [VA: Alt+O]"/>
                <TextBlock FontFamily="Consolas" Margin="0,2" TextWrapping="Wrap" Text="Alt+U, J   Go To Implementation   [VA: Alt+G]"/>
                <TextBlock FontFamily="Consolas" Margin="0,2" TextWrapping="Wrap" Text="Alt+U, R   Go To Related          [VA: Shift+Alt+G]"/>
                <TextBlock FontFamily="Consolas" Margin="0,2" TextWrapping="Wrap" Text="Alt+U, M   List Methods in File   [VA: Alt+M]"/>
                <TextBlock FontFamily="Consolas" Margin="0,2" TextWrapping="Wrap" Text="Alt+U, F   Find References        [VA: Shift+Alt+F]"/>
                <TextBlock FontFamily="Consolas" Margin="0,2" TextWrapping="Wrap" Text="Alt+U, W   Definition Preview (live declaration + implementation)"/>
            </StackPanel>

            <TextBlock Text="Visual Assist–style Refactoring" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="DodgerBlue"/>
            <StackPanel Margin="8,0,0,12">
                <TextBlock FontFamily="Consolas" Margin="0,2" TextWrapping="Wrap" Text="Alt+U, N   Rename (preview + CoreRedirect)  [VA: Shift+Alt+R]"/>
                <TextBlock FontFamily="Consolas" Margin="0,2" TextWrapping="Wrap" Text="Alt+U, A   Add Include"/>
                <TextBlock FontFamily="Consolas" Margin="0,2" TextWrapping="Wrap" Text="Alt+U, C   Create Declaration (from .cpp definition)"/>
                <TextBlock FontFamily="Consolas" Margin="0,2" TextWrapping="Wrap" Text="Alt+U, V   Move Implementation to Source"/>
                <TextBlock FontFamily="Consolas" Margin="0,2" TextWrapping="Wrap" Text="Alt+U, P   Encapsulate Field"/>
                <TextBlock FontFamily="Consolas" Margin="0,2" TextWrapping="Wrap" Text="Alt+U, Q   Document Method"/>
                <TextBlock FontFamily="Consolas" Margin="0,2" TextWrapping="Wrap" Text="Alt+U, T   Insert Snippet / Surround With (C++ + SDL2 snippets)"/>
                <TextBlock FontFamily="Consolas" Margin="0,2" TextWrapping="Wrap" Text="Alt+U, B   Implement Virtual Methods"/>
                <TextBlock FontFamily="Consolas" Margin="0,2" TextWrapping="Wrap" Text="Alt+U, L   Add Missing Case Statements"/>
                <TextBlock FontFamily="Consolas" Margin="0,2" TextWrapping="Wrap" Text="Alt+U, X   Introduce Variable"/>
                <TextBlock FontFamily="Consolas" Margin="0,2" TextWrapping="Wrap" Text="Alt+U, Z   Add Forward Declaration"/>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.75"
                           Text="To use Visual Assist's own keys, search for the command name (e.g. 'FindSymbol') in Tools › Options › Environment › Keyboard and assign it. Typing '(' after an Unreal function shows its declaration and docs (signature help)."/>
            </StackPanel>

            <!-- Auto-Completion -->
            <TextBlock Text="Auto-Completion" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="DodgerBlue"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                Type inside macro parentheses to get context-aware suggestions:
            </TextBlock>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" FontFamily="Consolas" Text="UPROPERTY(..." Margin="0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="EditAnywhere, BlueprintReadWrite, Category, Transient, Replicated, etc." Margin="4,2" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="1" Grid.Column="0" FontFamily="Consolas" Text="UFUNCTION(..." Margin="0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="BlueprintCallable, BlueprintPure, Server, Client, Reliable, etc." Margin="4,2" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="2" Grid.Column="0" FontFamily="Consolas" Text="UCLASS(..." Margin="0,2"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Blueprintable, Abstract, NotPlaceable, Config, meta=(), etc." Margin="4,2" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="3" Grid.Column="0" FontFamily="Consolas" Text="USTRUCT(..." Margin="0,2"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="BlueprintType, Atomic, NoExport, etc." Margin="4,2" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="4" Grid.Column="0" FontFamily="Consolas" Text="UENUM(..." Margin="0,2"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="BlueprintType, Flags, etc." Margin="4,2" TextWrapping="Wrap"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
