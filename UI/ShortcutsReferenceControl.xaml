<UserControl x:Class="PenguinExtention.UI.ShortcutsReferenceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
             Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
        <StackPanel Margin="8">

            <TextBlock Text="🐧 PenguinExtension Shortcuts" FontSize="16" FontWeight="Bold"
                       Margin="0,0,0,12"/>

            <!-- Navigation -->
            <TextBlock Text="Navigation" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="DodgerBlue"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" FontFamily="Consolas" Text="Ctrl+Shift+U, D" Margin="0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Go To Unreal Definition — Navigate to the source of the symbol under cursor" Margin="4,2" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="1" Grid.Column="0" FontFamily="Consolas" Text="Ctrl+Shift+U, E" Margin="0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Open Unreal Explorer — Browse all indexed Unreal symbols" Margin="4,2" TextWrapping="Wrap"/>
            </Grid>

            <!-- Refactoring -->
            <TextBlock Text="Refactoring" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="DodgerBlue"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" FontFamily="Consolas" Text="Ctrl+Shift+U, I" Margin="0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Generate Implementation — Create .cpp skeleton from .h function declaration" Margin="4,2" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="1" Grid.Column="0" FontFamily="Consolas" Text="Ctrl+Shift+U, G" Margin="0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Generate Getter/Setter — Create Get/Set methods from UPROPERTY" Margin="4,2" TextWrapping="Wrap"/>
            </Grid>

            <!-- Tool Windows -->
            <TextBlock Text="Tool Windows" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="DodgerBlue"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" FontFamily="Consolas" Text="Ctrl+Shift+U, S" Margin="0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Symbol Inspector — Live documentation for the symbol under cursor" Margin="4,2" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="1" Grid.Column="0" FontFamily="Consolas" Text="Ctrl+Shift+U, K" Margin="0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Keyboard Shortcuts — This window" Margin="4,2" TextWrapping="Wrap"/>
            </Grid>

            <!-- Auto-Completion -->
            <TextBlock Text="Auto-Completion" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="DodgerBlue"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                Type inside macro parentheses to get context-aware suggestions:
            </TextBlock>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" FontFamily="Consolas" Text="UPROPERTY(..." Margin="0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="EditAnywhere, BlueprintReadWrite, Category, Transient, Replicated, etc." Margin="4,2" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="1" Grid.Column="0" FontFamily="Consolas" Text="UFUNCTION(..." Margin="0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="BlueprintCallable, BlueprintPure, Server, Client, Reliable, etc." Margin="4,2" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="2" Grid.Column="0" FontFamily="Consolas" Text="UCLASS(..." Margin="0,2"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Blueprintable, Abstract, NotPlaceable, Config, meta=(), etc." Margin="4,2" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="3" Grid.Column="0" FontFamily="Consolas" Text="USTRUCT(..." Margin="0,2"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="BlueprintType, Atomic, NoExport, etc." Margin="4,2" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="4" Grid.Column="0" FontFamily="Consolas" Text="UENUM(..." Margin="0,2"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="BlueprintType, Flags, etc." Margin="4,2" TextWrapping="Wrap"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
